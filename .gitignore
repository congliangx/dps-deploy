# Source-only repository. Deployment output belongs in deployment.yaml runtime_root.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/installstep.md
!/bmc-access.md
!/deployment.yaml
!/docs/
!/dps-install/
!/hardware-sim/
!/verification/
/docs/*
!/docs/*.md
/dps-install/*
!/dps-install/*.md
!/dps-install/scripts/
!/dps-install/config/
!/dps-install/templates/
/dps-install/templates/*
!/dps-install/templates/topology-4rack-dps09.json
!/dps-install/packages/
/dps-install/scripts/*
!/dps-install/scripts/*.py
!/dps-install/scripts/*.sh
!/dps-install/scripts/*.md
/dps-install/config/*
!/dps-install/config/artifact-sources.json
!/dps-install/config/values.example.yaml
!/dps-install/config/runtime-images.json
!/dps-install/config/gb300-power-shelf-devices.yaml
!/dps-install/config/prs/
/dps-install/config/prs/*
!/dps-install/config/prs/runtime-images.json
# Our LDAP build recipe is source; downloaded packages and image archives are output.
/dps-install/packages/*
!/dps-install/packages/ldap/
/dps-install/packages/ldap/*
!/dps-install/packages/ldap/build/
/dps-install/packages/ldap/build/*
!/dps-install/packages/ldap/build/Dockerfile
!/dps-install/packages/ldap/build/entrypoint.sh
!/dps-install/packages/ldap/build/SHA256SUMS
/hardware-sim/*
!/hardware-sim/*.md
!/hardware-sim/scripts/
!/hardware-sim/templates/
/hardware-sim/scripts/*
!/hardware-sim/scripts/*.py
!/hardware-sim/scripts/*.sh
/hardware-sim/templates/*
!/hardware-sim/templates/nodes.json
/verification/*
!/verification/README.md
!/verification/scripts/
/verification/scripts/*
!/verification/scripts/*.py
!/verification/scripts/*.sh

# Guard against accidental copies of private/runtime material into the source tree.
**/data/
**/logs/
**/archive/
**/__pycache__/
*.py[cod]
.env
.env.*
*.env
*.key
*.pem
*.crt
*kubeconfig*
*credentials.json
*-secret.yaml
*.dump
*.ldif
*.deb
*.tar
*.tar.gz
*.tar.zst
*.tgz
.DS_Store
*.swp
*.tmp
# refresh-kubeconfig.py is maintained source, not an administrator configuration.
!/dps-install/scripts/refresh-kubeconfig.py
